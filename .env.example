# ── Talent Desk · Supabase (hosted preferred for Vercel) ────────────────────
# Copy to `.env` locally. On Vercel set the same names under Project → Settings → Environment Variables.
# Never commit real keys. VITE_* are baked at build time — change → redeploy.

# HOSTED (required for Vercel production — local Docker is NOT reachable from Vercel)
# Create a project at https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LOCAL Docker only (dev on your machine — do not use this URL on Vercel)
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Service role — NEVER put in VITE_* / browser / Vercel client env.
# Use for one-time migrate + Edge Functions only:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
