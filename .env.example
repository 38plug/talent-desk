# ── Talent Desk · Supabase env ──────────────────────────────────────────────
# Copy to `.env` (Vite loads it automatically). Never commit real keys.

# LOCAL (default — Docker Supabase on this machine)
#   1. Start Docker Desktop
#   2. `npx supabase start`
#   3. Paste URL + anon key from `npx supabase status`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# TUNNEL (only when the SPA is hosted remotely and must reach local Docker)
# Point Cloudflared at the Supabase API port 54321 — NOT the Vite/app port.
# Example: cloudflared tunnel --url http://127.0.0.1:54321
# Then set:
# VITE_SUPABASE_URL=https://<your-54321-tunnel>.trycloudflare.com
# VITE_SUPABASE_ANON_KEY=<same anon key from supabase status>
#
# Wrong tunnel (app port) → login fails with HTML-as-JSON / Unexpected token '<'.
# Docker down / wrong URL → auth UI shows “Cannot reach Talent Desk auth server”
# instead of raw “fetch failed”. Health check: {URL}/auth/v1/health → 200.

# Service role — NEVER expose to the browser / VITE_* vars.
# Used only by Supabase Edge Functions (register, admin-stats, admin-account)
# and local scripts. Set via `supabase secrets` or function env:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
