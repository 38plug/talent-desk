# ── Talent Desk · hosted Supabase (cloud sync) ─────────────────────────────
# Copy to `.env` locally. On Vercel: Project → Settings → Environment Variables.
# Vite inlines VITE_* at build time — change → redeploy.
# Without these, the SPA falls back to browser localStorage (device-local).
# Never commit real keys. Never put the service_role key in VITE_* / the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role — Dashboard / one-time SQL / optional Edge Functions ONLY:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
