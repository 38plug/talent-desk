# ── Talent Desk · hosted Supabase (cloud sync) ─────────────────────────────
# Copy to `.env` locally. On Vercel: Project → Settings → Environment Variables.
# Vite inlines VITE_* at build time — change → redeploy.
# Without these, the SPA falls back to browser localStorage (device-local).
# Never commit real keys. Never put the service/secret role key in VITE_* / the browser.

VITE_SUPABASE_URL=https://oglaqmpevvvuxnhntiiz.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Secret / service_role — NEVER put in VITE_* / browser / Vercel client env.
# Use only for SQL/migrations (Dashboard SQL Editor or CLI with DB password / sbp_ token).
# SUPABASE_SERVICE_ROLE_KEY=do-not-put-here
