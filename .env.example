# ── Talent Desk · Supabase env ──────────────────────────────────────────────
# Copy to `.env` (Vite loads it automatically). Never commit real keys.
#
# Required for login/register. Missing/placeholder values → auth banner explains
# what to do (no raw "fetch failed").

# LOCAL (default — Docker Supabase on this machine)
#   1. Start Docker Desktop
#   2. `npx supabase start`
#   3. Paste API URL + anon key from `npx supabase status`
#   4. Confirm http://127.0.0.1:54321/auth/v1/health returns 200
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# TUNNEL (only when a remote host must reach local Docker Supabase)
# Point Cloudflared at the Supabase API port 54321 — NOT Vite (5173) or an old app port.
#   cloudflared tunnel --url http://127.0.0.1:54321
# Then:
# VITE_SUPABASE_URL=https://<your-54321-tunnel>.trycloudflare.com
# VITE_SUPABASE_ANON_KEY=<same anon key from supabase status>
#
# Wrong tunnel (app port) → HTML-as-JSON / Unexpected token '<'
# Docker down / bad URL → auth UI: “Cannot reach Talent Desk auth server”

# Service role — NEVER put in VITE_* or the browser.
# Only for Edge Functions (register, admin-stats, admin-account) / local scripts:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
